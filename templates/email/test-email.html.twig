{# templates/email/test-email.html.twig #}
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>Test Email</title>
</head>
<body>
{# Se c'è un WYSIWYG nel Document, stampalo in RAW #}
{% set htmlEditable = pimcore_wysiwyg('body')|default('') %}
{% if htmlEditable|trim %}
    {{ htmlEditable|raw }}
{% else %}
    <div style="max-width: 600px; margin: auto; background: white; padding: 20px; border-radius: 5px;">
        <h2 style="color: #333;">Hello,</h2>
        <p style="color: #555;">This is a test email sent from our Symfony application.</p>
        <p style="color: #555;">Thank you for using our service!</p>
        <br>
        <p style="color: #999; font-size: 12px;">&copy; {{ "now"|date("Y") }} Your Company. All rights reserved.</p>
    </div>
{% endif %}
</body>
</html>