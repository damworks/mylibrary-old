{# templates/email/test-email.html.twig #}
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>Test Email</title>
</head>
<body>
{# Se c'è un WYSIWYG nel Document, stampalo in RAW #}
{% set htmlEditable = pimcore_wysiwyg('body')|default('') %}
{% if htmlEditable|trim %}
    {{ htmlEditable|raw }}
{% else %}
    <div>
        <h2>Hello,</h2>
        <p>This is a test email sent from our Symfony application.</p>
        <p>IP: {{ ip }}.</p>
        <p>Thank you for using our service!</p>
        <br />
        <p>&copy; {{ year }} Your Company. All rights reserved.</p>
    </div>
{% endif %}
</body>
</html>